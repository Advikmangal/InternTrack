DATABASE_URL=postgresql+psycopg://interntrack:change-me@localhost:5432/interntrack
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
COOKIE_SECURE=false
COOKIE_NAME=interntrack_session
SESSION_DAYS=7
ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
# Docker Compose only: choose a local URL-safe password before running Compose.
# POSTGRES_PASSWORD=replace-with-your-local-password

# Google OAuth (optional). Configure a Web application client in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_KEY=
